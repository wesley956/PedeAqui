# Release hashes cover exact downloaded bytes, including on Windows checkouts.
# Source contracts use LF. Keep the same bytes on Windows and Linux.
*.sql text eol=lf
*.css text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
print-agent/src/*.mjs text eol=lf
print-agent/pilot/*.mjs text eol=lf
print-agent/package.json text eol=lf
print-agent/manifest.json text eol=lf
