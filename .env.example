# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API — server-only. The database stores only these variable names/references.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Configure the Graph API version explicitly (example format: vNN.N); do not hardcode it in source.
WHATSAPP_GRAPH_API_VERSION=

# Application
APP_URL=http://localhost:3000
LOG_LEVEL=info
