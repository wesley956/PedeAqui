# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API — server-only. The database stores only variable names/references.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Configure the Graph API version explicitly (example format: vNN.N); do not hardcode it in source.
WHATSAPP_GRAPH_API_VERSION=

# Meta Embedded Signup — PedeAqui platform credentials, all server-only.
# META_APP_ID is safe to be sent to the Embedded Signup client only after server readiness validation.
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_BUSINESS_ID=
META_SYSTEM_USER_ID=
META_SYSTEM_USER_ACCESS_TOKEN=

# Application
APP_URL=http://localhost:3000
LOG_LEVEL=info
