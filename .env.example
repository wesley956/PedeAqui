# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API — server-only. The database stores only variable names/references.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Configure the Graph API version explicitly (example format: vNN.N); do not hardcode it in source.
WHATSAPP_GRAPH_API_VERSION=

# Meta Embedded Signup — PedeAqui platform credentials, all server-only.
# META_APP_ID is safe to be sent to the Embedded Signup client only after server readiness validation.
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Optional: use a dedicated Meta login configuration for WhatsApp Business App coexistence.
# When omitted, PedeAqui reuses META_EMBEDDED_SIGNUP_CONFIG_ID.
META_EMBEDDED_SIGNUP_COEXISTENCE_CONFIG_ID=
# Session information version used by the official Embedded Signup flow. Defaults to 3.
META_EMBEDDED_SIGNUP_SESSION_INFO_VERSION=3
META_BUSINESS_ID=
META_SYSTEM_USER_ID=
META_SYSTEM_USER_ACCESS_TOKEN=

# Mercado Pago OAuth — credenciais usadas para conectar o Mercado Pago dos restaurantes.
# Redirect URI must exactly match a static HTTPS URL registered in the Mercado Pago application.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_OAUTH_REDIRECT_URI=
# Secret signature configured for Order webhook notifications of restaurant/order payments.
MERCADO_PAGO_ORDER_WEBHOOK_SECRET=

# Cobrança da assinatura SaaS PedeAqui — conta Mercado Pago da própria plataforma.
# Mantida separada das credenciais e recebimentos dos restaurantes.
PEDEAQUI_BILLING_MERCADO_PAGO_ACCESS_TOKEN=
PEDEAQUI_BILLING_MERCADO_PAGO_WEBHOOK_SECRET=
# Protege jobs internos e é enviado pelo Vercel Cron como Bearer no ambiente de produção.
CRON_SECRET=

# Application
APP_URL=http://localhost:3000
LOG_LEVEL=info
